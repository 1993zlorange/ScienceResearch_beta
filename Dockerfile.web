# Build the existing same-origin Vue DOM app and serve it through Nginx.
FROM node:24-bookworm-slim AS web-build
WORKDIR /work
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --workspace apps/web --ignore-scripts
COPY apps/web ./apps/web
RUN npm --workspace apps/web run build

FROM nginx:1.27-alpine
COPY config/nginx/scienceresearch.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /work/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
