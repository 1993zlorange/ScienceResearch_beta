# Copy to a local environment file; never commit real values.
SCIENCERESEARCH_ENVIRONMENT=local
SCIENCERESEARCH_DATABASE_URL=postgresql+psycopg://scienceresearch:replace-with-local-password@localhost:5432/scienceresearch
SCIENCERESEARCH_ARTIFACT_ROOT=storage/artifacts
SCIENCERESEARCH_LOG_LEVEL=INFO

# Docker Compose-only isolated deployment values.
POSTGRES_PASSWORD=replace-with-local-password
SCIENCERESEARCH_WEB_BIND_ADDRESS=127.0.0.1
SCIENCERESEARCH_WEB_PORT=8765
